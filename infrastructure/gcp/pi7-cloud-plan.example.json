{
  "egress": {
    "api": [
      "google_oidc",
      "neon",
      "aws_sts",
      "dynamodb"
    ],
    "policy": "default_deny",
    "web": [
      "api",
      "google_oidc"
    ],
    "worker": [
      "google_oidc",
      "neon",
      "aws_sts",
      "dynamodb"
    ]
  },
  "features": {
    "agents": false,
    "deletion": false,
    "export": false,
    "external_consumers": false,
    "external_turns": false,
    "maintenance": false,
    "memory": false,
    "memory_controls": false,
    "profile_sharing": false,
    "reference_apps": false,
    "research": false,
    "retrieval": false
  },
  "iam": {
    "api_invoker": [
      "personal-ai-web-runtime@pi7-synthetic.iam.gserviceaccount.com"
    ],
    "neon_secret_accessor": [
      "personal-ai-api-runtime@pi7-synthetic.iam.gserviceaccount.com",
      "personal-ai-worker-runtime@pi7-synthetic.iam.gserviceaccount.com"
    ],
    "pubsub_publishers": [
      "personal-ai-api-runtime@pi7-synthetic.iam.gserviceaccount.com"
    ],
    "pubsub_token_creator": {
      "member": "service-100000000001@gcp-sa-pubsub.iam.gserviceaccount.com",
      "target": "personal-ai-pubsub-invoker@pi7-synthetic.iam.gserviceaccount.com"
    },
    "worker_invoker": [
      "personal-ai-pubsub-invoker@pi7-synthetic.iam.gserviceaccount.com"
    ]
  },
  "identity": {
    "api_audience": "https://pi7-api.run.app",
    "audience": "pi7-synthetic.apps.googleusercontent.com",
    "auth_mode": "google_oidc",
    "auth_required": true,
    "hosted_domain": "example.test",
    "issuer": "https://accounts.google.com",
    "owner_email": "operator@example.test",
    "web_origin": "https://pi7.example.test",
    "worker_audience": "https://pi7-worker.run.app"
  },
  "images": {
    "api": "us-central1-docker.pkg.dev/pi7-synthetic/personal-ai/backend@sha256:1111111111111111111111111111111111111111111111111111111111111111",
    "web": "us-central1-docker.pkg.dev/pi7-synthetic/personal-ai/frontend@sha256:2222222222222222222222222222222222222222222222222222222222222222",
    "worker": "us-central1-docker.pkg.dev/pi7-synthetic/personal-ai/backend@sha256:1111111111111111111111111111111111111111111111111111111111111111"
  },
  "inference": {
    "cost_mode": "offline_fake",
    "embedding": "disabled",
    "external_provider_kill_switch": true,
    "extraction": "disabled",
    "profile": "offline_fake",
    "provider": "fake",
    "source_scopes": [],
    "summary": "disabled"
  },
  "limits": {
    "api_requests_per_minute": 60,
    "model_physical_calls": 0,
    "provider_spend_microusd": 0,
    "search_physical_calls": 0
