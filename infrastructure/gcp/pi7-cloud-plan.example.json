      },
      "worker": {
        "account": "personal-ai-worker-runtime@pi7-synthetic.iam.gserviceaccount.com",
        "azp_or_aud": "100000000000000000002",
        "oaud": "https://pi7.example.test/personal-ai-runtime",
        "sub": "100000000000000000002"
      }
    },
    "aws_region": "us-east-1",
    "aws_role": "arn:aws:iam::000000000000:role/pi7-synthetic",
    "dynamodb_table": "pi7-synthetic",
    "neon_host": "ep-synthetic-pooler.us-east-1.aws.neon.tech",
    "neon_secret_version": "projects/pi7-synthetic/secrets/pi7-synthetic-dsn/versions/1"
