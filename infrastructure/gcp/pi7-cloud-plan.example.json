  "project": "pi7-synthetic",
  "project_number": "100000000001",
  "region": "us-central1",
  "rollback": "quarantine_and_review_prior_revision",
  "schema": "pi7-cloud-plan-v1",
  "services": {
    "api": {
      "account": "personal-ai-api-runtime@pi7-synthetic.iam.gserviceaccount.com",
      "audience": "https://pi7-api.run.app",
      "concurrency": 10,
      "ingress": "internal",
      "invoker": "personal-ai-web-runtime@pi7-synthetic.iam.gserviceaccount.com",
      "max_instances": 1,
      "min_instances": 0
    },
    "web": {
      "account": "personal-ai-web-runtime@pi7-synthetic.iam.gserviceaccount.com",
      "concurrency": 20,
      "ingress": "public",
      "invoker": "public",
      "max_instances": 1,
      "min_instances": 0,
      "proxy": {
        "audience": "https://pi7-api.run.app",
        "forward_verified_user_jwt": true,
        "target": "api"
      }
    },
    "worker": {
      "account": "personal-ai-worker-runtime@pi7-synthetic.iam.gserviceaccount.com",
      "audience": "https://pi7-worker.run.app",
      "concurrency": 1,
      "ingress": "internal",
      "invoker": "personal-ai-pubsub-invoker@pi7-synthetic.iam.gserviceaccount.com",
      "max_instances": 1,
      "min_instances": 0,
      "push_auth": "google_oidc",
      "push_endpoint": "/tasks/memory"
    }
  },
  "storage": {
    "aws_audience": "https://pi7.example.test/personal-ai-runtime",
    "aws_google_claims": {
      "api": {
        "account": "personal-ai-api-runtime@pi7-synthetic.iam.gserviceaccount.com",
        "azp_or_aud": "100000000000000000001",
